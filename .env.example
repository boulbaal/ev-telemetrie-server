# Kopieer naar .env (cp .env.example .env) en vul in. .env komt NOOIT in git.

# Adres van de website die de aanvragen beheert, zonder slash op het einde.
#   testkopie: https://volt-rescue-garage.lovable.app
#   live:      https://evbatterymotorservice.eu   (pas na de overzetting)
SITE_URL=

# Gedeeld geheim tussen deze server en de website. Moet exact gelijk zijn aan
# het secret TELEMETRIE_SECRET in het websiteproject (Lovable -> Settings -> Secrets).
# Zelf een lange willekeurige tekst kiezen, bv.:  openssl rand -hex 32
TELEMETRIE_SECRET=

# Client-ID van de Tesla-ontwikkelaarsapp (developer.tesla.com -> app -> Credentials).
# Nodig om een verlopen token van de klant te vernieuwen.
TESLA_CLIENT_ID=

# Het publieke adres van deze server en de poort waarop de wagens verbinden.
# Moet gelijk zijn aan de instellingen in het beheer van de website
# (/admin/instellingen: telemetrie_host / telemetrie_poort) en aan het certificaat.
TELEMETRIE_HOST=telemetrie.evbatterymotorservice.eu
TELEMETRIE_POORT=4433

# Pad naar de private Tesla-sleutel van de app (EC prime256v1, PEM).
# Standaard ./keys/private-key.pem. NOOIT in git, nooit per mail.
# TESLA_PRIVATE_KEY=./keys/private-key.pem

# Optioneel
# TESLA_FLEET_BASE=https://fleet-api.prd.eu.vn.cloud.tesla.com   (Europa; NA: ...prd.na...)
# TESLA_AUTH_BASE=https://auth.tesla.com
# POLL_INTERVAL_MS=60000
